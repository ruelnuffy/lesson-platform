# Application
APP_NAME="Daily Lessons"
ENVIRONMENT=development
TIMEZONE=Africa/Lagos

# Database
POSTGRES_USER=dailylessons
POSTGRES_PASSWORD=dailylessons_dev_password
POSTGRES_DB=dailylessons
DATABASE_URL=postgresql+psycopg://dailylessons:dailylessons_dev_password@postgres:5432/dailylessons

# Auth & Security
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# CORS & URLs
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PAYMENT_PAGE_URL=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM="Daily Lessons <no-reply@example.com>"

# Scheduler (Worker)
DAILY_EMAIL_HOUR=6
DAILY_EMAIL_MINUTE=30
